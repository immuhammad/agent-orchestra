# per-checkout state (never migrated between machines/worktrees)
.worktrees/
.harness/state/
*.log
*.heartbeat
merge-watch-state
deferred-nudges
inbox/*/*.msg
inbox/*/*.ack
!inbox/*/.gitkeep
auto-resume-state.json
gatekeeper-alert-state.json
watch-flagged-dead

# stray reviewer scratch that landed OUTSIDE a scratch dir (#173: agy
# redirected `gh pr diff`/`gh pr view` straight into the project root as
# pr17.diff/pr17_body.txt and left them behind) -- catches this even for
# an agent that hasn't adopted the .harness/scratch/agy/ convention yet
pr*.diff
pr*_body.txt

# dual-installed skill pack (bin/orc-install-skills dogfooded on this repo
# itself, e.g. for agy to review here) -- skills/ is the source, these are
# installed copies, never tracked
.claude/*
.agents/*
.harness/*

# per-project root files -- each project that adopts
# this harness copies these from templates/ and customizes its own copy;
# never tracked here (or in a consumer project). templates/*.md are the
# tracked reference/seed.
/AGENTS.md
/CLAUDE.md
/GEMINI.md
/review-protocol.md
/project/*
